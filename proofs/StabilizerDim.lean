/-! ## Lower bound: ten independent elements of k -/

theorem basis_in_k :
    basis.map constraint = List.replicate 10 (List.replicate 128 0) := by decide +kernel

theorem last_basis_is_Xw : basis.getD 9 [] = Xw := by decide +kernel

theorem independent : mmul Wm Nmat 10 = mscale 30 (idMat 10) := by decide +kernel

/-! ## Upper bound: every element of k lies in the span of the basis -/

theorem upper_bound :
    madd (mmul Nmat Wm 64) (sparseMmul Am Emat 64) = mscale 30 (idMat 64) := by decide +kernel

/-! ## Orbit rank at Pi_0 is exactly 9 -/

def images : List (List Int) := basis.map (fun X => flat (mmul X Pi0 4))

theorem orbit_zero : images.getD 9 [] = List.replicate 32 0 := by decide +kernel

theorem orbit_independent :
    mmul W2m (tr (images.take 9) 32) 9 = mscale 1 (idMat 9) := by decide +kernel

